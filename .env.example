# Copy this file to .env and fill in real values. Never commit .env.

# InfluxDB
INFLUX_URL=http://localhost:8086
INFLUX_ORG=your-org
INFLUX_TOKEN=your-influx-token
INFLUX_BUCKET=ScoutWeather
INFLUX_LABJACK_BUCKET=JabLack

# Weather station (serial-over-TCP bridge)
WEATHER_SERIAL_URL=socket://192.168.0.87:8899

# AWS (used by influx-to-kinesis)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-southeast-2
KINESIS_STREAM_NAME=weather-station-scout-dataStream

# Sensors on USB (run on the host, not in Docker)
LIGHT_LOGGER_PORT=/dev/tty.usbserial-142130
PYRO_SENSITIVITY=10.0

# api-test
API_URL=https://your-api-id.execute-api.ap-southeast-2.amazonaws.com/prod/resource
